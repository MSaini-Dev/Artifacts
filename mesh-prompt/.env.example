# ==============================================================================
# Mesh & Brain Studio Environment Configuration
# ==============================================================================

# 1. Android Phone -> PC Mesh Prompt Execution Token (Port 8766)
# Shared bearer token required for remote prompt execution via POST /prompt.
# Configure the exact same token in the Android app under Settings > Shared Bearer Token.
# When the Android app sends prompts, it sends: 'Authorization: Bearer <token>'
MESH_PROMPT_TOKEN=your-mesh-prompt-secret-token-here

# 2. Peer Agent Token (Port 8000)
# Used by peer agents for server-to-server RPC on port 8000.
# Distinct from MESH_PROMPT_TOKEN.
MESH_AGENT_TOKEN=your-mesh-agent-secret-token-here

# 3. Optional Gemini API Key (if using Google AI models on PC or Studio)
# GEMINI_API_KEY=MY_GEMINI_API_KEY
